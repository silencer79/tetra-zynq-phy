# Ralph generated files (inside .ralph/ subfolder)
.ralph/.call_count
.ralph/.last_reset
.ralph/.exit_signals
.ralph/status.json
.ralph/.ralph_session
.ralph/.ralph_session_history
.ralph/.claude_session_id
.ralph/.response_analysis
.ralph/.circuit_breaker_state
.ralph/.circuit_breaker_history

# Ralph logs and generated docs
.ralph/logs/*
!.ralph/logs/.gitkeep
.ralph/docs/generated/*
!.ralph/docs/generated/.gitkeep

# General logs
*.log

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
.temp/

# Node modules (if using Node.js projects)
node_modules/

# Python cache (if using Python projects)
__pycache__/
*.pyc

# Rust build (if using Rust projects)
target/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Ralph backup directories (created by migration)
.ralph_backup_*

# Ralph agent configuration and logs
.ralph/
.ralphrc

# LibreSDR Vivado block design (not our source code)
libresdr/

# Vivado generated files in project root
.Xil/
tight_setup_hold_pins.txt
*.backup.jou

# =============================================================================
# FPGA / Vivado Build Artifacts
# =============================================================================

# Vivado project files (generated by vivado_build.tcl)
build/
sim_out/
*.jou
*.str
*.mif

# Vivado project directory (if created interactively)
*.xpr
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.srcs/
vivado_pid*.str

# Bitstreams (large binary, regenerate from source)
*.bit
*.bin
*.ltx

# Vivado checkpoints (large, regenerate)
*.dcp

# Simulation outputs
*.vcd
*.vvp
*.fst
*.ghw

# iverilog compilation artifacts
*.vvp

# SSH keys (never commit credentials)
github
github.pub

# Compiled simulation binaries in tb/
tb/tb_ad9361_adapter

# Python test vector outputs (regenerated by gen_*.py scripts)
tb/vectors/*.hex
tb/vectors/*.txt
!tb/vectors/README.md

# Xilinx log files
*.log
xsim.dir/

# Vivado auto-generated constraint files
*.xdc.orig

# Air-test captures (purged 2026-04-29 — never commit)
*.wav
*.cfile
*.dcp

# Vivado IP generation cache (regenerated)
.gen/

# Compiled SW binaries (regenerated by sw/Makefile)
sw/tetra_attach_daemon
sw/tetra_sysinfo
sw/tetra_ul_mon
sw/test_grpack
sw/test_cmce_parser
sw/test_cmce_body
